# Same-origin: the Vite dev proxy locally; in production the server serves the app and the API from one address.
VITE_API_BASE_URL=/api
# Web push: the server's VAPID_PUBLIC_KEY (the same value). Leave blank to build without push.
VITE_VAPID_PUBLIC_KEY=
# Build number sent as X-App-Version. Read from the shell environment only, not from this file. Normally unset: the
# build stamps its own time (YYYYMMDDHHmm, UTC).
VITE_APP_VERSION=
# The name shown in the app (header, login, browser tab, Home Screen label). Blank uses the built-in default.
VITE_APP_NAME=
