# Same-origin: the Vite dev proxy locally, the Vercel rewrite in production.
VITE_API_BASE_URL=/api
# Web push: the server's VAPID_PUBLIC_KEY (the same value). Leave blank to build without push.
VITE_VAPID_PUBLIC_KEY=
# Build number sent as X-App-Version. Leave blank: the build stamps its own time (YYYYMMDDHHmm, UTC).
VITE_APP_VERSION=
