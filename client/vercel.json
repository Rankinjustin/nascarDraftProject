{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-BACKEND-HOST/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!assets/|icons/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
