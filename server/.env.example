# Copy to server/.env for local development. Every variable the app uses is listed here (SPEC Section 16).

DATABASE_URL=postgresql://postgres:devpostgres@localhost:5432/draft_and_draft
# Integration tests only. Must be a separate database whose name ends in _test; it is wiped on every run.
TEST_DATABASE_URL=postgresql://postgres:devpostgres@localhost:5432/draft_and_draft_test
NODE_ENV=development
PORT=3001

SESSION_COOKIE_NAME=dnd_session
# Exact frontend URL; used for the Origin check.
FRONTEND_ORIGIN=http://localhost:5173
# Proxy hops in front of the API. 0 locally; see SPEC Section 5 for production.
TRUST_PROXY=0

# Error tracking. Leave blank locally.
SENTRY_DSN=
# Oldest client build the API accepts (YYYYMMDDHHmm, UTC — the client stamps its build time). Blank = accept all.
# Bump only when a deploy changes the API in a way old clients can't handle.
MIN_CLIENT_VERSION=

# Web push. Generate once with `npx web-push generate-vapid-keys`, never rotate casually (it orphans every
# subscription). VAPID_SUBJECT is a mailto: address. The client's VITE_VAPID_PUBLIC_KEY must match the public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional second notification channel: a Discord channel webhook URL.
DISCORD_WEBHOOK_URL=
NASCAR_FEED_BASE_URL=https://cf.nascar.com
# Kill switch for the live-feed poller ("true" to run it). Off by default so local dev doesn't poll NASCAR.
FEED_POLL_ENABLED=false

# Quiet hours (turn notifications held overnight; equal start and end disables them), reminder timing.
LEAGUE_TIMEZONE=America/Chicago
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
PICK_REMINDER_HOURS=12
DEADLINE_WARNING_HOURS=12
