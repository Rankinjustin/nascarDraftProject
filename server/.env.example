# Copy to server/.env for local development. Every variable the app uses is listed here (SPEC Section 16).
# Ones marked "later" aren't read until their phase is built.

DATABASE_URL=postgresql://postgres:devpostgres@localhost:5432/draft_and_draft
NODE_ENV=development
PORT=3001

SESSION_COOKIE_NAME=dnd_session
# Exact frontend URL; used for the Origin check.
FRONTEND_ORIGIN=http://localhost:5173
# Proxy hops in front of the API. 0 locally; see SPEC Section 5 for production.
TRUST_PROXY=0

# Error tracking. Leave blank locally.
SENTRY_DSN=
# Later (Phase 4): oldest client build the API accepts.
MIN_CLIENT_VERSION=

# Later (Phase 4): web push. Generate once, never rotate casually. VAPID_SUBJECT is a mailto: address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Later (Phase 4): optional second notification channel.
DISCORD_WEBHOOK_URL=
NASCAR_FEED_BASE_URL=https://cf.nascar.com
# Later (Phase 5): kill switch for the poller.
FEED_POLL_ENABLED=false

# Quiet hours only.
LEAGUE_TIMEZONE=America/Chicago
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
PICK_REMINDER_HOURS=12
DEADLINE_WARNING_HOURS=12
